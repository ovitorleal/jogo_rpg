[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/combat/combat_scene.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/combat/combat_board.gd" id="2_board"]

[sub_resource type="Theme" id="Theme_small"]
default_font_size = 9

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.102, 0.078, 0.137, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.522, 0.592, 0.722, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[node name="CombatScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_small")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.102, 0.078, 0.137, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.902, 0.882, 0.827, 1)
theme_override_font_sizes/font_size = 12
text = "Combate"

[node name="Columns" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Board" type="Control" parent="Margin/Layout/Columns"]
unique_name_in_owner = true
custom_minimum_size = Vector2(384, 256)
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 0
script = ExtResource("2_board")

[node name="Side" type="VBoxContainer" parent="Margin/Layout/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="OrderLabel" type="Label" parent="Margin/Layout/Columns/Side"]
layout_mode = 2
theme_override_colors/font_color = Color(0.522, 0.592, 0.722, 1)
text = "Iniciativa"

[node name="TurnOrder" type="RichTextLabel" parent="Margin/Layout/Columns/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/default_color = Color(0.902, 0.882, 0.827, 1)
theme_override_font_sizes/normal_font_size = 9
theme_override_font_sizes/bold_font_size = 9
bbcode_enabled = true
fit_content = true

[node name="LogLabel" type="Label" parent="Margin/Layout/Columns/Side"]
layout_mode = 2
theme_override_colors/font_color = Color(0.522, 0.592, 0.722, 1)
text = "Registro"

[node name="LogPanel" type="PanelContainer" parent="Margin/Layout/Columns/Side"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Log" type="RichTextLabel" parent="Margin/Layout/Columns/Side/LogPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/default_color = Color(0.902, 0.882, 0.827, 1)
theme_override_font_sizes/normal_font_size = 8
theme_override_font_sizes/bold_font_size = 8
bbcode_enabled = true
scroll_following = true

[node name="Status" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.878, 0.706, 0.541, 1)
text = "..."

[node name="Actions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="AttackLabel" type="Label" parent="Margin/Layout/Actions"]
layout_mode = 2
text = "Ataque:"

[node name="AttackOption" type="OptionButton" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="EndTurnButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
text = "Encerrar turno"

[node name="PotionButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
tooltip_text = "Beber uma Poção de Cura (ação bônus): 2d4+2 PV"
text = "Poção"

[node name="FleeButton" type="Button" parent="Margin/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "Fugir"

[node name="Hint" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.522, 0.592, 0.722, 1)
theme_override_font_sizes/font_size = 8
text = "Clique numa casa azul para mover · clique num inimigo com moldura vermelha tracejada para atacar"

[node name="ResultPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -110.0
offset_top = -50.0
offset_right = 110.0
offset_bottom = 50.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="ResultPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="ResultPanel/Margin"]
layout_mode = 2
alignment = 1

[node name="ResultLabel" type="Label" parent="ResultPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.902, 0.882, 0.827, 1)
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1

[node name="ResultButton" type="Button" parent="ResultPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Continuar"
